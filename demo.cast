[113.335293, "o", "\u001b[0;32mok: [80.240.52.147] => (item={'listen': '443 ssl', 'http2': True, 'server_name': 'rdgw.kptech.ru', 'filename': 'rdgw.kptech.ru.ssl.conf', 'extra_parameters': 'ssl_certificate     /etc/letsencrypt/live/rdgw.kptech.ru/fullchain.pem;\\nssl_certificate_key /etc/letsencrypt/live/rdgw.kptech.ru/privkey.pem;\\n\\nssl_protocols       TLSv1.2 TLSv1.3;\\nssl_session_cache   shared:SSL:10m;\\nssl_session_timeout 10m;\\nadd_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;\\n\\nlocation /minio/ {\\n    proxy_pass http://127.0.0.1:9000/;\\n    proxy_set_header Host $host;\\n    proxy_set_header X-Real-IP $remote_addr;\\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\\n    proxy_set_header X-Forwarded-Proto $scheme;\\n    proxy_redirect off;\\n}\\nlocation /minio-admin/ {\\n    proxy_pass http://127.0.0.1:9001/;\\n    proxy_set_header Host $host;\\n    proxy_set_header X-Real-IP $remote_addr;\\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\\n    proxy_set_header X-Forwarded-Proto $scheme;\\n    proxy_http_version 1.1;\\n    proxy_set_header Upgrade $http_upgrade;\\n    proxy_set_header Connection \"upgrade\";\\n    proxy_redirect off;\\n}\\nlocation / {\\n    proxy_pass http://127.0.0.1:8080;\\n    proxy_set_header Host              $http_host;\\n    proxy_set_header X-Real-IP         $remote_addr;\\n    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;\\n    proxy_set_header X-Forwarded-Proto $scheme;\\n}\\n'})\u001b[0m\r\n"]
